# Copy these NAMES into your shell environment. Never create a real .env file in this repo.
# LLM_PROVIDER=anthropic            # or: openai_compatible
# ANTHROPIC_API_KEY=                # for provider anthropic
# REVIEW_MODEL=                     # model id (a default exists for anthropic)
# LLM_BASE_URL=                     # openai_compatible only, e.g. https://api.openai.com/v1
# LLM_API_KEY=                      # openai_compatible only
